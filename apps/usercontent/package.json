{
	"name": "@superset/usercontent",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun scripts/dev.ts",
		"dev:personal": "bun --env-file=../../.env scripts/personal.ts",
		"deploy": "wrangler deploy",
		"typecheck": "tsc --noEmit --emitDeclarationOnly false",
		"typecheck:personal": "tsc -p tsconfig.personal.json --noEmit --emitDeclarationOnly false"
	},
	"dependencies": {
		"@sentry/cloudflare": "10.68.0",
		"@superset/shared": "workspace:*",
		"hono": "4.13.7",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "3.899.0",
		"@cloudflare/workers-types": "5.20260801.1",
		"@superset/typescript": "workspace:*",
		"typescript": "7.0.2",
		"wrangler": "4.118.0"
	}
}
